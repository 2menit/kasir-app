// Photobooth Cashier — Prisma schema
// See CLAUDE.md §5 and SRS §6 for the source spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the app (serverless-safe).
  url      = env("DATABASE_URL")
  // Direct connection for migrations (Neon/Supabase pooler can't run them).
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum EventStatus {
  UPCOMING
  ONGOING
  DONE
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
}

enum PricingType {
  BIASA // single flat price per print
  PISAH // first print at pricePerPrint, same-photo copies at copyPrice
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String // bcrypt hash (rounds = 12)
  role      Role     @default(USER)

  // City assignment: null for SUPERADMIN, required for ADMIN & USER
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  // Login-lockout state (REQ-AUTH-01: 5 failed attempts -> lock 15 min)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crewEvents   EventCrew[]
  transactions Transaction[]
}

model Event {
  id            String      @id @default(cuid())
  name          String
  location      String
  eventDateStart DateTime
  eventDateEnd   DateTime
  startTime     DateTime? // optional precise start (WIB)
  endTime       DateTime? // optional precise end (WIB)
  pricingType   PricingType @default(BIASA)
  pricePerPrint Int // base / first-print price (Rp)
  copyPrice     Int? // per same-photo copy price (Rp); used when pricingType = PISAH
  // Optional per-event add-ons (e.g. gantungan kunci) — JSON array of
  // { name: string, price: number }. New multi-add-on field (replaces the
  // legacy single addOn* fields below for new writes).
  addOns        Json?
  // Legacy single add-on fields (kept for backward compat with old rows;
  // new writes use addOns JSON array above).
  addOnEnabled  Boolean     @default(false)
  addOnName     String?
  addOnPrice    Int?
  // Per-event payment method toggles (superadmin configurable)
  allowCash     Boolean     @default(true)
  allowQris     Boolean     @default(true)

  // Revenue split between "kita" and "panitia" (must total 100 when enabled)
  splitEnabled       Boolean @default(false)
  splitKitaPercent   Int     @default(80) // our share (e.g. 80%)
  splitPanitiaPercent Int    @default(20) // panitia share (e.g. 20%)

  status        EventStatus @default(UPCOMING)
  notes         String?

  // City tag: required for all new events, backfilled to Jember for existing
  cityId        String?
  city          City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  crew         EventCrew[]
  transactions Transaction[]
}

model EventCrew {
  id       String  @id @default(cuid())
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  attended Boolean @default(false)

  @@unique([eventId, userId])
  @@index([userId])
}

model Transaction {
  id            String        @id @default(cuid())
  // Idempotency key generated client-side (UUID v4) for offline-sync.
  // Nullable so legacy/online transactions are unaffected.
  clientTempId  String?       @unique
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  // Who input it. Nullable so historical transactions survive user deletion (SRS §6.2).
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  printCount    Int
  paymentMethod PaymentMethod
  // Add-on items sold in this transaction — JSON array of
  // { name: string, qty: number, unitPrice: number }. Snapshots the
  // add-on config at transaction time for accurate recap (new field).
  addOnItems     Json?
  // Legacy single add-on snapshot fields (kept for backward compat).
  addOnQty       Int           @default(0)
  addOnUnitPrice Int           @default(0)
  total         Int // (prints + add-on) total in Rp, computed server-side
  note          String?
  createdAt     DateTime      @default(now())

  @@index([eventId, createdAt])
  @@index([userId])
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Jember", "Jakarta"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]  // admin & crew assigned to this city
  events Event[] // events tagged to this city
}
